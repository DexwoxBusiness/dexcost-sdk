{
  "name": "@dexcost/sdk",
  "version": "0.24.1",
  "description": "Agent Unit Economics SDK for Node.js",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dexcost": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/cjs/middleware/index.js"
    },
    "./integrations/otel": {
      "types": "./dist/integrations/otel.d.ts",
      "import": "./dist/integrations/otel.js",
      "require": "./dist/cjs/integrations/otel.js"
    },
    "./integrations/ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "import": "./dist/integrations/ai-sdk.js",
      "require": "./dist/cjs/integrations/ai-sdk.js"
    },
    "./integrations/langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js",
      "require": "./dist/cjs/integrations/langchain.js"
    },
    "./clients": {
      "types": "./dist/clients.d.ts",
      "import": "./dist/clients.js",
      "require": "./dist/cjs/clients.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && node scripts/build-cjs.mjs",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/package-types.consumer.ts",
    "test:catalog-probe": "node scripts/catalog-release-probe-selftest.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "decimal.js": "^10.6.0",
    "js-yaml": "^4.3.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "@aws-sdk/client-bedrock-runtime": ">=3.0.0",
    "@fal-ai/client": ">=1.0.0",
    "@google/generative-ai": ">=0.20.0",
    "@google/genai": ">=2.0.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "@openrouter/agent": ">=0.9.0 <1.0.0",
    "@openrouter/sdk": ">=1.0.0 <2.0.0",
    "@perplexity-ai/perplexity_ai": ">=0.30.0",
    "ai": ">=3.0.0",
    "better-sqlite3": ">=11.0.0",
    "cohere-ai": ">=7.0.0",
    "ollama": ">=0.5.0",
    "openai": ">=4.0.0",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@fal-ai/client": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@openrouter/agent": {
      "optional": true
    },
    "@openrouter/sdk": {
      "optional": true
    },
    "@perplexity-ai/perplexity_ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "ollama": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "12.8.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@openrouter/agent": "0.9.0",
    "@openrouter/sdk": "1.2.42",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "esbuild": "0.25.12",
    "rxjs": "^7.8.2",
    "typescript": "^5.3.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "keywords": [
    "ai",
    "agents",
    "cost-tracking",
    "llm",
    "observability"
  ],
  "license": "MIT",
  "homepage": "https://docs.dexcost.io/docs/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DexwoxBusiness/dexcost-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/DexwoxBusiness/dexcost-sdk/issues"
  }
}
