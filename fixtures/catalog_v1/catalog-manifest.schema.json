{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexcost.io/catalog-release/manifest.v1.json",
  "title": "DexCost Catalog Release Manifest v1",
  "$comment": "Ed25519 signs UTF-8 bytes: 'dexcost.catalog-release.v1\\u0000' followed by canonical JSON of the complete manifest with signatures replaced by an empty array. At least one configured trusted key must verify before authoritative or offline activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_sequence",
    "channel",
    "published_at",
    "expires_at",
    "safety_policy_version",
    "sdk_contract",
    "server_pricing_reference",
    "artifacts",
    "signatures"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "release_id": {
      "type": "string",
      "pattern": "^catalog-release-[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "channel": { "enum": ["stable", "canary"] },
    "published_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "safety_policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "sdk_contract": { "$ref": "#/$defs/sdkContract" },
    "server_pricing_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_version", "activation_id"],
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "activation_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_rules",
        "llm_prices",
        "service_prices",
        "compute_prices",
        "gpu_prices",
        "egress_prices",
        "server_pricing_reference"
      ],
      "properties": {
        "observer_rules": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "observer_rules" } } }
          ]
        },
        "llm_prices": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "llm_prices" } } }
          ]
        },
        "service_prices": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "service_prices" } } }
          ]
        },
        "compute_prices": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "compute_prices" } } }
          ]
        },
        "gpu_prices": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "gpu_prices" } } }
          ]
        },
        "egress_prices": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "egress_prices" } } }
          ]
        },
        "server_pricing_reference": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            { "properties": { "kind": { "const": "server_pricing_reference" } } }
          ]
        }
      }
    },
    "signatures": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "key_id", "signature"],
        "properties": {
          "algorithm": { "enum": ["ed25519"] },
          "key_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "sdkContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "sha256",
        "byte_size",
        "item_count",
        "media_type",
        "path",
        "sdk_contract"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observer_rules",
            "llm_prices",
            "service_prices",
            "compute_prices",
            "gpu_prices",
            "egress_prices",
            "server_pricing_reference"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,8}$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_size": { "type": "integer", "minimum": 2, "maximum": 5242880 },
        "item_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "media_type": { "const": "application/json" },
        "path": {
          "type": "string",
          "pattern": "^/v1/catalogs/artifacts/sha256/[0-9a-f]{64}$"
        },
        "sdk_contract": { "$ref": "#/$defs/sdkContract" }
      }
    }
  }
}
