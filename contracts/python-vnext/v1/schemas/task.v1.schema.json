{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexcost.io/python-vnext/task.v1.json",
  "title": "DexCost operational task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "task_type", "status", "started_at", "ended_at", "metadata",
    "customer_id", "project_id", "parent_task_id", "experiment_id", "variant",
    "llm_cost_usd", "external_cost_usd", "compute_cost_usd", "network_cost_usd",
    "gpu_cost_usd", "total_cost_usd", "total_input_tokens", "total_output_tokens",
    "total_cached_tokens", "retry_count", "retry_cost_usd", "failure_count",
    "network_bytes_in", "network_bytes_out", "network_call_count", "network_by_host",
    "schema_version"
  ],
  "properties": {
    "task_id": { "$ref": "#/$defs/uuid" },
    "task_type": { "type": "string", "maxLength": 256 },
    "status": { "enum": ["pending", "success", "failed"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "metadata": { "type": "object" },
    "customer_id": { "$ref": "#/$defs/nullableOpaque256" },
    "project_id": { "$ref": "#/$defs/nullableOpaque256" },
    "user_id": { "$ref": "#/$defs/opaque512" },
    "product_id": { "$ref": "#/$defs/opaque512" },
    "parent_task_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "root_task_id": { "$ref": "#/$defs/uuid" },
    "agent_id": { "$ref": "#/$defs/opaque256" },
    "agent_version": { "$ref": "#/$defs/opaque256" },
    "workflow_id": { "$ref": "#/$defs/opaque256" },
    "workflow_session_id": { "$ref": "#/$defs/opaque256" },
    "experiment_id": { "$ref": "#/$defs/nullableOpaque256" },
    "variant": { "$ref": "#/$defs/nullableOpaque256" },
    "llm_cost_usd": { "$ref": "#/$defs/decimal" },
    "external_cost_usd": { "$ref": "#/$defs/decimal" },
    "compute_cost_usd": { "$ref": "#/$defs/decimal" },
    "network_cost_usd": { "$ref": "#/$defs/decimal" },
    "gpu_cost_usd": { "$ref": "#/$defs/decimal" },
    "total_cost_usd": { "$ref": "#/$defs/decimal" },
    "total_input_tokens": { "$ref": "#/$defs/counter" },
    "total_output_tokens": { "$ref": "#/$defs/counter" },
    "total_cached_tokens": { "$ref": "#/$defs/counter" },
    "retry_count": { "$ref": "#/$defs/counter" },
    "retry_cost_usd": { "$ref": "#/$defs/decimal" },
    "failure_count": { "$ref": "#/$defs/counter" },
    "network_bytes_in": { "$ref": "#/$defs/counter" },
    "network_bytes_out": { "$ref": "#/$defs/counter" },
    "network_call_count": { "$ref": "#/$defs/counter" },
    "network_by_host": { "type": "object" },
    "schema_version": { "const": "1" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "counter": { "type": "integer", "minimum": 0 },
    "opaque256": { "type": "string", "minLength": 1, "maxLength": 256 },
    "opaque512": { "type": "string", "minLength": 1, "maxLength": 512 },
    "nullableOpaque256": {
      "oneOf": [{ "$ref": "#/$defs/opaque256" }, { "type": "null" }]
    }
  }
}
