{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexcost.io/python-vnext/catalog-observer-rules.v1.json",
  "title": "DexCost declarative observer-rule catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "observers"],
  "properties": {
    "_meta": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "observer_count", "purpose"],
      "properties": {
        "version": { "type": "string", "pattern": "^[1-9][0-9]*(?:\\.[0-9]+){0,2}$" },
        "observer_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "observers": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
    "canonicalName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "canonicalUnit": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$" },
    "queryParameter": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "headerName": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,256}$" },
    "jsonPath": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\[\\]-]{0,511}$" },
    "interoperableNumber": { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "jsonPredicateScalar": { "anyOf": [{ "type": "string" }, { "type": "boolean" }, { "$ref": "#/$defs/interoperableNumber" }] },
    "queryPredicate": {
      "type": "object", "additionalProperties": false, "required": ["parameter", "operator"],
      "properties": {
        "parameter": { "$ref": "#/$defs/queryParameter" },
        "operator": { "enum": ["present", "truthy", "equals", "absent_or_equals", "all_non_empty"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        { "if": { "properties": { "operator": { "enum": ["equals", "absent_or_equals"] } } }, "then": { "required": ["value"] } },
        { "if": { "properties": { "operator": { "enum": ["present", "truthy", "all_non_empty"] } } }, "then": { "not": { "required": ["value"] } } }
      ]
    },
    "responsePredicate": {
      "type": "object", "additionalProperties": false, "required": ["path", "operator"],
      "properties": {
        "path": { "$ref": "#/$defs/jsonPath" }, "operator": { "enum": ["equals", "collection_all_equals", "one_of", "non_empty", "absent_or_empty_collection"] },
        "value": { "$ref": "#/$defs/jsonPredicateScalar" },
        "values": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/jsonPredicateScalar" } }
      },
      "allOf": [
        { "if": { "properties": { "operator": { "enum": ["equals", "collection_all_equals"] } } }, "then": { "required": ["value"], "not": { "required": ["values"] } } },
        { "if": { "properties": { "operator": { "const": "one_of" } } }, "then": { "required": ["values"], "not": { "required": ["value"] } } },
        { "if": { "properties": { "operator": { "enum": ["non_empty", "absent_or_empty_collection"] } } }, "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["values"] }] } } }
      ]
    },
    "requestPredicate": {
      "type": "object", "additionalProperties": false, "required": ["path", "operator"],
      "properties": {
        "path": { "$ref": "#/$defs/jsonPath" },
        "operator": { "enum": ["absent_or_null", "absent_or_false_or_null", "absent_or_empty_collection", "absent_or_lte", "equals", "not_equals", "string_not_contains", "array_contains"] },
        "value": { "$ref": "#/$defs/jsonPredicateScalar" }
      },
      "allOf": [
        { "if": { "properties": { "operator": { "const": "absent_or_null" } } }, "then": { "not": { "required": ["value"] } } },
        { "if": { "properties": { "operator": { "const": "absent_or_false_or_null" } } }, "then": { "not": { "required": ["value"] } } },
        { "if": { "properties": { "operator": { "const": "absent_or_empty_collection" } } }, "then": { "not": { "required": ["value"] } } },
        { "if": { "properties": { "operator": { "const": "absent_or_lte" } } }, "then": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/interoperableNumber" } } } },
        { "if": { "properties": { "operator": { "enum": ["equals", "not_equals"] } } }, "then": { "required": ["value"], "properties": { "value": { "anyOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "string", "minLength": 1, "maxLength": 256 }] } } } },
        { "if": { "properties": { "operator": { "const": "string_not_contains" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 256 } } } },
        { "if": { "properties": { "operator": { "const": "array_contains" } } }, "then": { "required": ["value"], "properties": { "value": { "anyOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "string", "minLength": 1, "maxLength": 256 }] } } } }
      ]
    },
    "requestHeaderPredicate": {
      "type": "object", "additionalProperties": false, "required": ["name", "operator"],
      "properties": {
        "name": { "$ref": "#/$defs/headerName" },
        "operator": { "enum": ["present", "absent", "equals", "one_of", "basic_username_prefix"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "values": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      },
      "allOf": [
        { "if": { "properties": { "operator": { "enum": ["present", "absent"] } } }, "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["values"] }] } } },
        { "if": { "properties": { "operator": { "const": "equals" } } }, "then": { "required": ["value"], "not": { "required": ["values"] } } },
        { "if": { "properties": { "operator": { "const": "basic_username_prefix" } } }, "then": { "required": ["value"], "not": { "required": ["values"] } } },
        { "if": { "properties": { "operator": { "const": "one_of" } } }, "then": { "required": ["values"], "not": { "required": ["value"] } } }
      ]
    },
    "collectionPredicate": {
      "type": "object", "additionalProperties": false, "required": ["path", "operator", "value"],
      "properties": {
        "path": { "$ref": "#/$defs/jsonPath" },
        "operator": { "enum": ["contains", "not_contains"] },
        "value": { "$ref": "#/$defs/jsonPredicateScalar" }
      }
    },
    "billingDimension": {
      "type": "object", "additionalProperties": false, "required": ["key", "source"],
      "properties": {
        "key": { "$ref": "#/$defs/canonicalName" },
        "source": { "enum": ["request_body", "response_body", "query_parameter", "path_parameter", "hostname"] },
        "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
        "default_value": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "hostname" } }, "required": ["source"] }, "then": { "not": { "required": ["selector"] } }, "else": { "required": ["selector"] } }
      ]
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["service_key", "provider_name", "provider_service", "component", "domains", "endpoints", "usage_metric", "resource_type", "source_url"],
      "properties": {
        "service_key": { "$ref": "#/$defs/identifier" },
        "provider_name": { "$ref": "#/$defs/identifier" },
        "provider_service": { "$ref": "#/$defs/identifier" },
        "component": { "enum": ["llm", "telephony", "voice_platform", "speech_to_text", "text_to_speech", "realtime_transport", "recording", "post_call_analysis", "compute", "gpu", "network", "storage", "external"] },
        "domains": { "type": "array", "minItems": 0, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" } },
        "domain_suffixes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" } },
        "provider_region_domain_label": { "type": "integer", "minimum": 0, "maximum": 10 },
        "allowed_provider_regions": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/canonicalName" } },
        "endpoints": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "pattern": "^/[A-Za-z0-9_./:{}-]{0,511}$" } },
        "excluded_endpoints": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^/[A-Za-z0-9_./:{}-]{0,511}$" } },
        "endpoint_match": { "enum": ["exact", "prefix", "path_template"] },
        "methods": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]+$" } },
        "response_path": { "$ref": "#/$defs/jsonPath" },
        "response_collection_sum_path": { "$ref": "#/$defs/jsonPath" },
        "response_quantity_header": { "type": "string", "minLength": 1, "maxLength": 256 },
        "request_character_count_path": { "$ref": "#/$defs/jsonPath" },
        "request_character_count_query_parameter": { "$ref": "#/$defs/queryParameter" },
        "request_character_count_case_insensitive": { "const": true },
        "request_collection_count_path": { "$ref": "#/$defs/jsonPath" },
        "request_collection_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/collectionPredicate" } },
        "paired_response_collection_path": { "$ref": "#/$defs/jsonPath" },
        "paired_response_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/requestPredicate" } },
        "character_count_encoding": { "enum": ["unicode_code_points", "utf16_code_units"] },
        "minimum_quantity": { "const": "1" },
        "fixed_quantity": { "const": "1" },
        "usage_metric": { "$ref": "#/$defs/canonicalName" },
        "usage_unit": { "$ref": "#/$defs/canonicalUnit" },
        "resource_type": { "enum": ["model", "sku", "instance", "endpoint", "session", "tool", "other"] },
        "resource_path": { "$ref": "#/$defs/jsonPath" },
        "request_resource_path": { "$ref": "#/$defs/jsonPath" },
        "resource_id_prefix_to_strip": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resource_query_parameter": { "$ref": "#/$defs/queryParameter" },
        "resource_path_parameter": { "$ref": "#/$defs/identifier" },
        "resource_hostname": { "const": true },
        "fixed_resource_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "default_resource_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "allowed_resource_ids": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "resource_variant": {
          "type": "object", "additionalProperties": false,
          "required": ["query_parameter", "equals", "matched_suffix", "default_suffix"],
          "properties": {
            "query_parameter": { "$ref": "#/$defs/queryParameter" }, "equals": { "type": "string", "minLength": 1, "maxLength": 256 },
            "matched_suffix": { "type": "string", "minLength": 1, "maxLength": 128 }, "default_suffix": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "quantity_multiplier_path": { "$ref": "#/$defs/jsonPath" },
        "quantity_multiplier_query_parameter": { "$ref": "#/$defs/queryParameter" },
        "quantity_multiplier_query_parameter_count": { "$ref": "#/$defs/queryParameter" },
        "query_any": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/queryPredicate" } },
        "query_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/queryPredicate" } },
        "request_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/requestPredicate" } },
        "request_header_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/requestHeaderPredicate" } },
        "response_all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/responsePredicate" } },
        "record_id_header": { "type": "string", "minLength": 1, "maxLength": 256 },
        "record_id_path": { "$ref": "#/$defs/jsonPath" },
        "provider_cost_usd_path": { "$ref": "#/$defs/jsonPath" },
        "provider_cost_usd_collection_sum_path": { "$ref": "#/$defs/jsonPath" },
        "provider_cost_minor_units_path": { "$ref": "#/$defs/jsonPath" },
        "provider_cost_currency_path": { "$ref": "#/$defs/jsonPath" },
        "provider_cost_minor_unit_exponent": { "type": "integer", "minimum": 0, "maximum": 6 },
        "billing_dimensions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/billingDimension" } },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "oneOf": [
        { "required": ["response_path"], "not": { "anyOf": [{ "required": ["response_collection_sum_path"] }, { "required": ["response_quantity_header"] }, { "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }, { "required": ["request_collection_count_path"] }, { "required": ["fixed_quantity"] }] } },
        { "required": ["response_collection_sum_path"], "not": { "anyOf": [{ "required": ["response_path"] }, { "required": ["response_quantity_header"] }, { "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }, { "required": ["request_collection_count_path"] }, { "required": ["fixed_quantity"] }] } },
        { "required": ["response_quantity_header"], "not": { "anyOf": [{ "required": ["response_path"] }, { "required": ["response_collection_sum_path"] }, { "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }, { "required": ["request_collection_count_path"] }, { "required": ["fixed_quantity"] }] } },
        { "anyOf": [{ "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }], "not": { "anyOf": [{ "required": ["response_path"] }, { "required": ["response_collection_sum_path"] }, { "required": ["response_quantity_header"] }, { "required": ["request_collection_count_path"] }, { "required": ["fixed_quantity"] }] } },
        { "required": ["request_collection_count_path"], "not": { "anyOf": [{ "required": ["response_path"] }, { "required": ["response_collection_sum_path"] }, { "required": ["response_quantity_header"] }, { "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }, { "required": ["fixed_quantity"] }] } },
        { "required": ["fixed_quantity"], "not": { "anyOf": [{ "required": ["response_path"] }, { "required": ["response_collection_sum_path"] }, { "required": ["response_quantity_header"] }, { "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }, { "required": ["request_collection_count_path"] }] } }
      ],
      "dependentRequired": {
        "quantity_multiplier_query_parameter": ["quantity_multiplier_path"],
        "request_collection_count_path": ["request_collection_all"],
        "request_collection_all": ["request_collection_count_path"],
        "paired_response_collection_path": ["paired_response_all", "request_collection_count_path"],
        "paired_response_all": ["paired_response_collection_path", "request_collection_count_path"],
        "provider_cost_minor_units_path": ["provider_cost_currency_path", "provider_cost_minor_unit_exponent"],
        "provider_cost_currency_path": ["provider_cost_minor_units_path", "provider_cost_minor_unit_exponent"],
        "provider_cost_minor_unit_exponent": ["provider_cost_minor_units_path", "provider_cost_currency_path"],
        "provider_region_domain_label": ["allowed_provider_regions"],
        "allowed_provider_regions": ["provider_region_domain_label"]
      },
      "allOf": [
        { "if": { "properties": { "domains": { "maxItems": 0 } }, "required": ["domains"] }, "then": { "required": ["domain_suffixes"] } },
        { "not": { "required": ["provider_cost_usd_path", "provider_cost_usd_collection_sum_path"] } },
        { "if": { "required": ["provider_cost_minor_units_path"] }, "then": { "not": { "anyOf": [{ "required": ["provider_cost_usd_path"] }, { "required": ["provider_cost_usd_collection_sum_path"] }] } } },
        { "if": { "properties": { "usage_metric": { "const": "request_count" } }, "required": ["usage_metric"] }, "then": { "required": ["fixed_quantity"] } },
        { "if": { "required": ["minimum_quantity"] }, "then": { "anyOf": [{ "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }] } },
        { "if": { "required": ["character_count_encoding"] }, "then": { "anyOf": [{ "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }] } },
        { "if": { "required": ["request_character_count_case_insensitive"] }, "then": { "required": ["request_character_count_path"] } },
        { "if": { "required": ["quantity_multiplier_query_parameter_count"] }, "then": { "required": ["query_all"], "anyOf": [{ "required": ["request_character_count_path"] }, { "required": ["request_character_count_query_parameter"] }] } },
        { "not": { "required": ["quantity_multiplier_query_parameter_count", "quantity_multiplier_path"] } },
        { "if": { "required": ["resource_id_prefix_to_strip"] }, "then": { "anyOf": [{ "required": ["resource_path"] }, { "required": ["request_resource_path"] }, { "required": ["resource_query_parameter"] }, { "required": ["fixed_resource_id"] }] } },
        { "if": { "required": ["allowed_resource_ids"] }, "then": { "anyOf": [{ "required": ["resource_path"] }, { "required": ["request_resource_path"] }] } },
        { "not": { "required": ["resource_path", "request_resource_path"] } },
        { "not": { "required": ["resource_path", "resource_query_parameter"] } },
        { "not": { "required": ["resource_path", "fixed_resource_id"] } },
        { "not": { "required": ["request_resource_path", "fixed_resource_id"] } },
        { "not": { "required": ["resource_query_parameter", "fixed_resource_id"] } }
      ]
    }
  }
}
