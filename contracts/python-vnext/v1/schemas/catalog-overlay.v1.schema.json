{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dexcost.io/python-vnext/catalog-overlay.v1.json",
  "title": "DexCost private workspace catalog overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_release_id", "base_release_sequence", "generated_at", "overrides"],
  "properties": {
    "schema_version": { "const": "1" },
    "base_release_id": { "type": "string", "pattern": "^catalog-release-[a-z0-9][a-z0-9._:-]{0,127}$" },
    "base_release_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "generated_at": { "type": "string", "format": "date-time" },
    "overrides": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "key", "rate_usd", "per", "notes", "updated_at"],
        "properties": {
          "kind": { "enum": ["service", "compute", "gpu", "egress"] },
          "key": { "type": "string", "minLength": 1, "maxLength": 512 },
          "rate_usd": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,18})?$" },
          "per": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "notes": { "type": ["string", "null"], "maxLength": 1000 },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
